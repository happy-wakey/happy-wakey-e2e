  "fleet": {
    "organization": "happy-wakey",
    "requiredRepositories": [
      "happy-wakey-admin-api-server.rs",
      "happy-wakey-admin-web-server.rs",
      "happy-wakey-api-server.rs",
      "happy-wakey-assets",
      "happy-wakey-cli",
      "happy-wakey-clients",
      "happy-wakey-desktop-app.rs",
      "happy-wakey-docs",
      "happy-wakey-e2e",
      "happy-wakey-flutter",
      "happy-wakey-infra",
      "happy-wakey-interfaces",
      "happy-wakey-lambdas",
      "happy-wakey-lib-core",
      "happy-wakey-mcp-server.rs",
      "happy-wakey-monorepo",
      "happy-wakey-orm-core",
      "happy-wakey-pub-lib-core",
      "happy-wakey-sidecar.rs",
      "happy-wakey-sync",
      "happy-wakey-web-server.rs",
      "happy-wakey.github.io",
      "happy-wakey.rs"
    ],
    "allRepositoriesNonEmpty": true,
    "archivedRepositoriesAllowed": false,
    "selfRevisionPolicy": "merged-commit-is-authority"
  },
  "sharedAuth": {
    "identityProof": "official-typed-protected-introspection",
    "serviceCredentialIndependent": true,
    "requiredAudience": "happy-wakey",
    "failClosed": true,
    "realmIsolation": true,
    "productAuthorization": "happy-wakey"
  },
  "telemetry": {
    "provider": "oresoftware/next-loggers-rust",
    "revision": "ca176fb6768a9750d262a536952268625ffd3a8a",
    "forbiddenFields": [
      "authorization",
      "cookie",
      "token",
      "bearer_token",
      "email",
      "owner_id",
      "provider_subject",
      "body"
    ]
  },
  "crossMode": {
    "automaticFallback": false,
    "responseContract": "happy-wakey-interfaces.ServiceOperationResponse",
    "subjectSource": "verified-shared-auth-subject",
    "maxRequestBytes": 32768,
    "maxResponseBytes": 921600
  },
  "onboarding": {
    "identityAuthority": "github.com/shared-auth",
    "accountKinds": ["individual", "organization"],
    "entryHosts": {
      "individual": "user.hawky.pro",
      "organization": "org.hawky.pro"
    },
    "organizationMembershipRoles": ["member", "manager", "org_admin", "owner"],
    "seatAllocationRequired": true,
    "connectorConsentRequired": true,
    "credentialsInProductDatabaseAllowed": false
  },
  "domains": {
    "hawky.pro": "marketing",
    "app.hawky.pro": "primary-web",
    "user.hawky.pro": "individual-login-and-pages",
    "org.hawky.pro": "organization-login-and-pages",
    "api.hawky.pro": "public-api",
    "main.hawky.pro": "organization-main-deep-link",
    "admin.hawky.pro": "private-admin-web",
    "admin-api.hawky.pro": "private-admin-api",
    "m.hawky.pro": "mobile-web"
  },
  "realtime": {
    "browserTransport": "cloudflare-durable-object-websocket-hibernation",
    "serverTransport": "tls-length-delimited-json",
    "tenantPartitioned": true,
    "sharedAuthAdmissionRequired": true,
    "maxWebSocketSessionSeconds": 900,
    "maxSocketsPerTenantObject": 128,
    "maxFrameBytes": 32768,
    "adminMcpNetwork": "private-vpc-mtls",
    "adminPublicIngressAllowed": false
  },
  "messageCuration": {
    "providers": ["email", "whatsapp", "linkedin", "x_dm", "slack", "teams"],
    "supportedApisWebhooksOrExportsOnly": true,
    "scrapingAllowed": false,
    "consentRequired": true,
    "minimumUsefulnessScore": 0.8,
    "decisionRequiresContentHash": true,
    "deepLinkRequiresUsefulDecision": true,
    "deepLinkRequiresReauthentication": true,
    "feedFallbackAllowed": false
  },
  "intelligence": {
    "independentInterfaceAuthorities": ["typespec", "json-schema"],
    "runtimeValidationAuthorities": ["json-schema", "protobuf"],
    "databaseScopeKeys": ["tenant_id", "subject_id"],
    "databaseRlsRequired": true,
    "vectorDimensions": {"minimum": 1, "maximum": 4100},
    "regressionCorrections": ["none", "bonferroni", "benjamini_hochberg"],
    "causalClaimsAllowed": false
  },
  "chat": {
    "authority": "github.com/ores-chat",
    "audiences": ["sales_visitor", "customer_support", "organization_admin", "internal_operator", "owner"],
    "explicitSearchScopesRequired": true,
    "adminMcpConnection": "private-vpc-mtls"
  },
  "commonBackend": {
    "middleware": "github.com/oresoftware/ores-middleware",
    "rateLimiting": "github.com/ores-rate-limit",
    "telemetry": "github.com/ores-otel",
    "stateSync": "github.com/opto-sync",
    "chat": "github.com/ores-chat",
    "cliConfiguration": "github.com/flags-2-env"
  },
  "bluetooth": {
    "serviceUuid": "8e0e0001-7d5a-4c3f-9c31-94e9d447fc01",
    "commandCharacteristicUuid": "8e0e0002-7d5a-4c3f-9c31-94e9d447fc01",
    "commandSchema": "happy-wakey.ble.preview-command.v1",
    "maxCommandBytes": 512,
    "scanTimeoutMs": 4000,
    "connectTimeoutMs": 8000,
    "credentialFieldsAllowed": false,
    "nativeImplementations": {
      "rust": "btleplug",
      "flutter": "universal_ble"
    },
    "formalLane": {
      "name": "bluetooth",
      "generationFenced": true,
      "staleCompletionsSuppressed": true
    }
  },
  "morningBrief": {
    "deliveryContract": "happy-wakey-interfaces.morning-briefing.v1",
    "compositionContract": "happy-wakey-interfaces.briefing-composition.v1",
    "cardKinds": [
      "this_day_in_history",
      "useful_message",
      "email_bottleneck",
      "team_bottleneck",
      "calendar",
      "weather",
      "extended_outlook",
      "flight",
      "market",
      "kpi",
      "task",
      "news",
      "audio_briefing"
    ],
    "compositionLanes": [
      "briefing",
      "day_plan",
      "tasks",
      "habits",
      "focus",
      "sleep",
      "biometrics",
      "inbox",
      "messages",
      "markets",
      "environment",
      "modules"
    ],
    "feedless": true,
    "maxWeatherCities": 10,
    "reliableForecastHorizonDays": 14,
    "extendedOutlookMaxDays": 21,
    "extendedOutlookUncertaintyLabelRequired": true,
    "surfaces": [
      {
        "id": "important_email",
        "section": "inbox",
        "route": "/v1/inbox/digest",
        "authorization": "provider-scoped-read-only",
        "contentPolicy": "metadata-or-bounded-snippet",
        "maxItems": 20
      },
      {
        "id": "direct_messages",
        "section": "messages",
        "route": "/v1/messages/digest",
        "authorization": "optional-gateway-policy-scoped",
        "contentPolicy": "platform-access-level",
        "maxItems": 20
      },
      {
        "id": "sleep",
        "section": "sleep",
        "route": "/v1/health/sleep/{day}",
        "authorization": "explicit-device-consent",
        "contentPolicy": "measured-or-modeled-labelled",
        "maxItems": 1
      },
      {
        "id": "biometrics",
        "section": "biometrics",
        "route": "/v1/health/biometrics/{day}",
        "authorization": "explicit-device-consent",
        "contentPolicy": "personal-baseline-no-diagnosis",
        "maxItems": 1
      }
    ],
    "bounds": {
      "maxSurfaces": 4,
      "maxItemsPerSurface": 20,
      "maxTextBytes": 4096
    },
    "failurePolicy": {
      "independentLanes": true,
      "failClosed": true,
      "degradedStateRequired": true
    }
  },
  "modes": [
    {
      "id": "direct_db_read",
      "transport": "lib-core-seaorm-subject-scoped",
      "webRole": "read-only-capability",
      "databaseRole": "read-only-principal",
      "rawConnectionExposed": false,
      "writesAllowed": false
    },
    {
      "id": "stateless_https",
      "transport": "https-json",
      "webRole": "bounded-client",
      "apiRole": "server",
      "redirectsAllowed": false,
      "bearerPerRequest": true
    },
    {
      "id": "stateful_tls",
      "transport": "tls-length-delimited-json",
      "webRole": "bounded-pooled-client",
      "apiRole": "bounded-server",
      "reauthenticateEveryFrame": true,
      "connectionIdentityCache": false,
      "idleTimeoutSeconds": 15,
      "maxRequestsPerConnection": 128
    },
    {
      "id": "async_jetstream",
      "transport": "nats-jetstream-outbox",
      "registration": "authenticated-https",
      "signalCredentialFree": true,
      "coreNatsAllowed": false,
      "topologyAuthority": "pre-provisioned-infra",
      "requestConsumer": "durable-explicit-ack-pull",
      "responseCommittedBeforePublish": true,
      "responsePublishAckBeforeRequestAck": true,
      "deterministicMessageId": true,
      "redeliveryReplaysStoredResponse": true,
      "outboxForbiddenFields": ["token", "bearer_token", "service_credential"]
    }
  ]
}
